ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_FAST_MODEL=claude-haiku-5-5

# auto = Anthropic if its key is set, else Gemini, else rule-based fallbacks
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FAST_MODEL=gemini-3.1-flash-lite
# USD per 1M tokens for models without a built-in price (cost shows as unknown otherwise)
LLM_PRICE_IN=0
LLM_PRICE_OUT=0

TAVILY_API_KEY=
EXA_API_KEY=
# free DuckDuckGo search when TAVILY_API_KEY is empty
USE_DDG=true

# bge-m3 is ~2.2GB; set USE_EMBEDDINGS=false on Streamlit Community Cloud
EMBEDDING_MODEL=BAAI/bge-m3
USE_EMBEDDINGS=false

# postgresql+psycopg://user:pass@host:5432/talent in prod
DATABASE_URL=sqlite:///talent_agent.db
ATS_CSV_PATH=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

USE_PLAYWRIGHT=true
MAX_PAGES=40
